PORT=3300
TZ=Asia/Shanghai
APP_BASE_PATH=/birthday

DB_HOST=mysql8
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=email_server
DB_CONN_LIMIT=10
DB_CONNECT_TIMEOUT=10000
DB_TIMEZONE=+08:00

AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=scrypt$replace-with-salt$replace-with-hash
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_SECONDS=43200
AUTH_COOKIE_SECURE=true

# WebAuthn 通行密钥登录（Face ID / 指纹）
# RP_ID 必须是站点域名；ORIGINS 为允许发起验证的完整来源，逗号分隔
WEBAUTHN_RP_ID=qisw.top
WEBAUTHN_RP_NAME=生日提醒中心
WEBAUTHN_ORIGINS=https://qisw.top,https://www.qisw.top,https://qisw.top:3300

SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=change-me@example.com
SMTP_PASS=change-me
SMTP_FROM=change-me@example.com
SCHEDULE_EMAIL_TO=change-me@example.com

BASE_APK_URL=https://qisw.top
JSON_BODY_LIMIT=64kb
API_RATE_LIMIT=300
TRUST_PROXY_HOPS=1
AUTH_LOGIN_LIMIT=10
SCHEDULE_EMAIL_LIMIT=30
APK_UPLOAD_MAX_BYTES=104857600
